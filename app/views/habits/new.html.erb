<div class="max-w-md mx-auto mt-12 p-6 bg-white shadow-md rounded-lg">
  <h2 class="text-2xl font-bold mb-6 text-center">New Habit</h2>

  <%= form_with(model: @habit, local: true) do |form| %>
    <div class="mb-4">
      <%= form.label :name, class: "block text-gray-700 font-medium mb-1" %>
      <%= form.text_field :name, class: "w-full border border-gray-300 rounded px-3 py-2" %>
    </div>

    <div class="mb-4">
      <%= form.label :frequency_unit, class: "block text-gray-700 font-medium mb-1" %>
      <%= form.select :frequency_unit, ['day', 'week', 'month'], {}, class: "w-full border border-gray-300 rounded px-3 py-2" %>
    </div>

    <div class="mb-4">
      <%= form.label :frequency_value, class: "block text-gray-700 font-medium mb-1" %>
      <%= form.number_field :frequency_value, class: "w-full border border-gray-300 rounded px-3 py-2" %>
    </div>

    <div class="mb-4">
      <%= form.label :start_date, class: "block text-gray-700 font-medium mb-1" %>
      <%= form.date_field :start_date, class: "w-full border border-gray-300 rounded px-3 py-2" %>
    </div>

    <div class="text-center">
      <%= form.submit "Create Habit", class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-2 rounded" %>
    </div>
  <% end %>
</div>
