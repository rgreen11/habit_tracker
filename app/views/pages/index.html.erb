
<% if current_user.habits.any? %>
    <div class="max-w-4xl mx-auto mt-12 p-6 bg-white shadow rounded-lg">
        <h1 class="text-2xl font-bold mb-6 text-center">Your Habit Progress</h1>

        <div class="flex justify-center">
            <div>
            <% @chart_data.each do |status, count| %>
                <p class="flex justify-left">
                    <strong><%= status.capitalize %>:</strong> 
                    <%= count %>
                </p>
            <% end %>
            </div>
            <%= pie_chart @chart_data, donut: true, library: { legend: { position: "top" } } %>
        </div>
    </div>
<% else %>
    <h1 class="text-2xl font-bold mb-6 text-center">Lets begin tracking your habits</h1>
<%end%>